+// RttiClassName reads an object's MSVC x64 RTTI: vtable[-1] is the complete
+// object locator, whose self RVA gives the image base and whose type descriptor
+// holds the decorated name ".?AVName@@". Every read is guarded; any mismatch
+// yields no name rather than a guess.
+std::optional<std::string> RttiClassName(const void* object) {
+  const unsigned char* vtable = nullptr;
+  if (!ReadNative(object, &vtable, sizeof(vtable)) || !vtable) return std::nullopt;
+  const unsigned char* locator = nullptr;
+  if (!ReadNative(vtable - sizeof(void*), &locator, sizeof(locator)) || !locator) return std::nullopt;
+  uint32_t header[6] = {};
+  if (!ReadNative(locator, header, sizeof(header)) || header[0] != 1) return std::nullopt;
+  const unsigned char* base = locator - header[5];
+  char name[160] = {};
+  if (!ReadNative(base + header[3] + 16, name, sizeof(name) - 1)) return std::nullopt;
+  const std::string_view text(name);
+  if (!text.starts_with(".?AV")) return std::nullopt;
+  const auto end = text.find("@@");
+  if (end == std::string_view::npos || end <= 4) return std::nullopt;
+  return std::string(text.substr(4, end - 4));
+}
